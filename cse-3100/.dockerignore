# ── Dependencies (installed during docker build) ──────────────
**/vendor
**/node_modules

# ── Build artifacts ───────────────────────────────────────────
**/dist

# ── Environment files (injected at runtime via docker-compose) ─
.env
.env.local
.env.*.local

# ── Version control ──────────────────────────────────────────
.git
.gitignore

# ── IDE / Editor files ───────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*.sublime-*

# ── OS generated files ──────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs (generated at runtime, not needed in image) ─────────
**/storage/logs/*.log

# ── Test files (not needed in production image) ──────────────
**/tests
**/.phpunit.*
**/phpunit.xml
